# Database (matches docker-compose.yml defaults)
DATABASE_URL="mysql://root:lebenshilfe@localhost:3306/lebenshilfe_dev"

# Better Auth
BETTER_AUTH_SECRET="VERY_GOOD_LOCAL_SECRET"  # generate with: openssl rand -base64 32
BETTER_AUTH_URL="http://localhost:3000"

# Hetzner Object Storage (S3-compatible) — required for signature uploads
# S3_ENDPOINT="https://fsn1.your-objectstorage.com"
# S3_REGION="fsn1"
# S3_BUCKET="lebenshilfe-signatures"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# Local S3 Emulator (Minio via Docker Compose)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="eu-central-1"
S3_BUCKET="lebenshilfe-local"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"

# Google Maps (Places + Maps Embed) — Schule lookup in /admin/children
# Enable in Google Cloud: Places API, Maps JavaScript API, Maps Embed API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=""
