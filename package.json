{
  "name": "lebenshilfe",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "printf '\\n\\033[36mTip: run `npm run db:seed` to (re-)populate the dev DB with comprehensive test data.\\033[0m\\n\\n' && next dev",
    "dev:local": "LOCAL_IP=$(node scripts/local-ip.mjs) && printf '\\n\\033[1;31m▲ Open the app at http://%s:3000 so that authentication works (localhost will fail).\\033[0m\\n' \"$LOCAL_IP\" && printf '\\033[36mTip: run `npm run db:seed` to (re-)populate the dev DB with comprehensive test data.\\033[0m\\n\\n' && BETTER_AUTH_URL=http://$LOCAL_IP:3000 NEXT_PUBLIC_APP_URL=http://$LOCAL_IP:3000 next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "db:push": "dotenv -e .env.local -- prisma db push",
    "db:seed": "docker compose up -d --wait && dotenv -e .env -- prisma migrate reset --force --skip-seed && BETTER_AUTH_URL=http://localhost:3000 dotenv -e .env -- npx tsx scripts/seed.ts",
    "docs:dev": "npm --prefix docs run dev",
    "docs:check": "npm --prefix docs run broken-links",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1097.0",
    "@googlemaps/js-api-loader": "^2.1.1",
    "@prisma/client": "^6.19.2",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "better-auth": "^1.6.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.27.0",
    "next": "^16.2.12",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.3",
    "pdf-lib": "^1.17.1",
    "perfect-debounce": "^2.1.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.19.2",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.8",
    "resend": "^6.18.1",
    "signature_pad": "^5.1.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "ts-pattern": "^5.9.0",
    "tw-animate-css": "^1.4.0",
    "use-places-autocomplete": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-boundaries": "^7.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,json,css,md,yml,yaml}": "prettier --write"
  },
  "overrides": {
    "tmp": "^0.2.7",
    "fast-xml-builder": "^1.3.0"
  }
}
