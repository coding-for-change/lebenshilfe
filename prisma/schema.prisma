generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SCHOOL_ASSISTANT
  OWNER
}

enum EventType {
  WORK
  SICK
}

enum SchulbegleiterStatus {
  INVITATION_PENDING
  ACCEPTED
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          Role      @default(SCHOOL_ASSISTANT)
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  sessions      Session[]
  accounts      Account[]
  assignments   ChildAssignment[]
  events        Event[]
  monthlyReports MonthlyReport[]
  profile       SchoolAssistantProfile?

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Invitation {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  role      Role     @default(SCHOOL_ASSISTANT)
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@map("invitation")
}

model Child {
  id                         String            @id @default(cuid())
  firstName                  String
  lastName                   String
  leosOne                    Boolean           @default(false)
  bescheid                   String?           @db.Text
  sbIb                       String?
  schweigepflichtsentbindung Boolean           @default(false)
  bemerkung                  String?           @db.Text
  schoolId                   String?
  kostentraegerId            String?
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt
  kostentraeger              Kostentraeger?    @relation(fields: [kostentraegerId], references: [id], onDelete: SetNull)
  school                     School?           @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  assignments                ChildAssignment[]
  schedules                  Schedule[]
  events                     Event[]
  absences                   ChildAbsence[]

  @@index([kostentraegerId])
  @@index([schoolId])
  @@map("child")
}

model School {
  id            String       @id @default(cuid())
  name          String
  address       String?
  placeId       String?
  lat           Decimal?     @db.Decimal(10, 7)
  lng           Decimal?     @db.Decimal(10, 7)
  holidayPlanId String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  children      Child[]
  holidayPlan   HolidayPlan? @relation(fields: [holidayPlanId], references: [id], onDelete: SetNull)

  @@index([holidayPlanId])
  @@map("school")
}

// A reusable holiday schedule shared across schools. Most schools use the same
// plan; schools with special closures (e.g. Europaschule) get their own.
model HolidayPlan {
  id        String             @id @default(cuid())
  name      String
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  holidays  HolidayPlanEntry[]
  schools   School[]

  @@map("holiday_plan")
}

model HolidayPlanEntry {
  id        String      @id @default(cuid())
  planId    String
  name      String? // e.g. "Sommerferien"
  startDate DateTime    @db.Date
  endDate   DateTime    @db.Date
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  plan      HolidayPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@map("holiday_plan_entry")
}

model ChildAssignment {
  id        String   @id @default(cuid())
  childId   String
  userId    String
  weekday   Int      @default(0)
  startTime String   @default("08:00")
  endTime   String   @default("14:00")
  tandem    Boolean  @default(false)
  createdAt DateTime @default(now())
  child     Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([childId, weekday])
  @@map("child_assignment")
}

model Kostentraeger {
  id        String   @id @default(cuid())
  name      String
  email     String?
  address   String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  children  Child[]

  @@map("kostentraeger")
}

model ChildAbsence {
  id        String   @id @default(cuid())
  childId   String
  date      DateTime @db.Date
  note      String?  @db.Text
  createdAt DateTime @default(now())
  child     Child    @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([childId, date])
  @@index([childId, date])
  @@map("child_absence")
}

model Schedule {
  id        String   @id @default(cuid())
  childId   String
  weekday   Int
  startTime String
  endTime   String
  createdAt DateTime @default(now())
  child     Child    @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId, weekday])
  @@map("schedule")
}

model Event {
  id           String    @id @default(cuid())
  childId      String?
  userId       String
  type         EventType
  date         DateTime  @db.Date
  startTime    String?
  endTime      String?
  note         String?   @db.Text
  signatureKey String? // !null -> by school assistant, null -> by admin
  deleted      Boolean   @default(false) // soft delete only for signed events; admin-created events are hard deleted
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  child        Child?    @relation(fields: [childId], references: [id])
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("event")
}

model MonthlyReport {
  id                     String   @id @default(cuid())
  userId                 String
  year                   Int
  month                  Int
  supervisorName         String
  supervisorSignatureKey String
  createdAt              DateTime @default(now())
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year, month])
  @@map("monthly_report")
}

model SchoolAssistantProfile {
  id                String               @id @default(cuid())
  userId            String?              @unique
  email             String               @unique
  name              String
  status            SchulbegleiterStatus @default(INVITATION_PENDING)
  leosOne           Boolean              @default(false)
  outlook           Boolean              @default(false)
  weeklyHours       Decimal?             @db.Decimal(5, 2)
  zvNeuNachBescheid Boolean              @default(false)
  zvNeuNote         String?              @db.Text
  introductionDay   DateTime?            @db.Date
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  user              User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  attendances       WorkshopAttendance[]

  @@index([status])
  @@map("school_assistant_profile")
}

model Workshop {
  id          String               @id @default(cuid())
  name        String
  description String?              @db.Text
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  attendances WorkshopAttendance[]

  @@map("workshop")
}

model WorkshopAttendance {
  id         String                 @id @default(cuid())
  workshopId String
  profileId  String
  attendedOn DateTime               @db.Date
  createdAt  DateTime               @default(now())
  workshop   Workshop               @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  profile    SchoolAssistantProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([workshopId, profileId])
  @@index([profileId])
  @@map("workshop_attendance")
}
